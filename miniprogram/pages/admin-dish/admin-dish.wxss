.admin-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding-bottom: 40rpx;
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.search-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F4F5F7;
  border-radius: 100rpx;
  padding: 0 28rpx;
  height: 76rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s;
}
.search-wrap:focus-within {
  background: #ffffff;
  border-color: #FF6B35;
}
.s-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.s-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D3436;
  height: 76rpx;
}
.s-placeholder {
  color: #B2BEC3;
}
.add-btn {
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(255, 87, 34, 0.2);
  white-space: nowrap;
}
.add-btn:active {
  transform: scale(0.95);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
  gap: 16rpx;
}

/* 列表 */
.dish-list {
  padding: 24rpx;
}
.dish-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s;
}
.dish-item:active {
  background: #FAFBFC;
}
.dish-main { flex: 1; }
.dish-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}
.cat-badge {
  background: rgba(255, 107, 53, 0.08);
  color: #FF6B35;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.dish-remark {
  font-size: 24rpx;
  color: #95A5A6;
}

.dish-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.act-edit {
  color: #FF6B35;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(255, 107, 53, 0.06);
  border-radius: 100rpx;
}
.act-edit:active {
  background: rgba(255, 107, 53, 0.12);
}
.act-delete {
  color: #E74C3C;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(231, 76, 60, 0.06);
  border-radius: 100rpx;
}
.act-delete:active {
  background: rgba(231, 76, 60, 0.12);
}

/* 弹窗字段 */
.field-group {
  margin-bottom: 24rpx;
}
.field-label {
  font-size: 26rpx;
  color: #636E72;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}
.field-input {
  background: #F4F5F7;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #2D3436;
  border: 2rpx solid transparent;
  transition: all 0.25s;
}
.field-input:focus {
  border-color: #FF6B35;
  background: #ffffff;
}
