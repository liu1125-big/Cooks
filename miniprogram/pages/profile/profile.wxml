<view class="profile-page" wx:if="{{userInfo}}">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="profile-bg"></view>
    <view class="user-card">
      <view class="avatar-wrap">
        <text class="avatar-emoji">👤</text>
      </view>
      <view class="user-detail">
        <view class="user-nickname">{{userInfo.nickname}}</view>
        <view class="user-username">@{{userInfo.username}}</view>
      </view>
      <view class="role-badge {{isAdmin ? 'role-admin' : 'role-user'}}">
        {{isAdmin ? '管理员' : '用户'}}
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-label">我的</view>
    <view class="menu-card">
      <view class="menu-row" bindtap="goHistory">
        <view class="menu-icon-wrap menu-icon-history">
          <text>📋</text>
        </view>
        <text class="menu-text">点餐历史</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 管理员入口 -->
  <view wx:if="{{isAdmin}}" class="menu-section">
    <view class="section-label">管理后台</view>
    <view class="menu-card">
      <view class="menu-row" bindtap="goAdminDish">
        <view class="menu-icon-wrap menu-icon-dish">
          <text>🍽️</text>
        </view>
        <text class="menu-text">菜品管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goAdminBuy">
        <view class="menu-icon-wrap menu-icon-buy">
          <text>🛒</text>
        </view>
        <text class="menu-text">采购管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goAdminUser">
        <view class="menu-icon-wrap menu-icon-user">
          <text>👥</text>
        </view>
        <text class="menu-text">用户管理</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-area">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>

<view wx:else class="loading-page">
  <view class="loading-spinner"></view>
  <text>加载中...</text>
</view>
