.profile-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding-bottom: 160rpx;
}

/* 头部 */
.profile-header {
  position: relative;
  padding-bottom: 20rpx;
}
.profile-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 260rpx;
  background: linear-gradient(135deg, #FF8C5A 0%, #FF5722 50%, #E64A19 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.user-card {
  position: relative;
  z-index: 1;
  margin: 60rpx 28rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FFF5EE, #FFE0CC);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.avatar-emoji {
  font-size: 48rpx;
}

.user-detail {
  flex: 1;
}
.user-nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 6rpx;
}
.user-username {
  font-size: 24rpx;
  color: #95A5A6;
}

.role-badge {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}
.role-admin {
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 87, 34, 0.2);
}
.role-user {
  background: rgba(149, 165, 166, 0.12);
  color: #636E72;
}

/* 菜单区块 */
.menu-section {
  padding: 0 28rpx;
  margin-top: 28rpx;
}
.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #95A5A6;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 32rpx;
  transition: background 0.2s;
  border-bottom: 1rpx solid #F6F7F9;
}
.menu-row:last-child {
  border-bottom: none;
}
.menu-row:active {
  background: #FAFBFC;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}
.menu-icon-history { background: rgba(52, 152, 219, 0.1); }
.menu-icon-dish { background: rgba(255, 107, 53, 0.1); }
.menu-icon-buy { background: rgba(39, 174, 96, 0.1); }
.menu-icon-user { background: rgba(155, 89, 182, 0.1); }

.menu-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #2D3436;
}
.menu-arrow {
  font-size: 36rpx;
  color: #B2BEC3;
  font-weight: 300;
}

/* 退出登录 */
.logout-area {
  padding: 48rpx 28rpx;
}
.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border: 2rpx solid rgba(231, 76, 60, 0.3);
  color: #E74C3C;
  background: transparent;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.logout-btn::after { border: none; }
.logout-btn:active {
  background: rgba(231, 76, 60, 0.04);
}

/* 加载状态 */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
  gap: 16rpx;
}
