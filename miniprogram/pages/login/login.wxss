.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #FF8C5A 0%, #FF5722 40%, #E64A19 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decor {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}
.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}
.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #ffffff;
  top: -100rpx;
  right: -80rpx;
}
.bg-circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #ffffff;
  bottom: 200rpx;
  left: -100rpx;
}

/* Hero Logo */
.hero-area {
  padding-top: 180rpx;
  padding-bottom: 60rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}
.logo-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}
.logo-text {
  font-size: 80rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 6rpx;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.12);
}
.logo-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* 表单卡片 */
.form-card {
  width: calc(100% - 80rpx);
  margin: 0 40rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 44rpx 48rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  border-bottom: 2rpx solid #F0F0F0;
  margin-bottom: 36rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #B2BEC3;
  position: relative;
  transition: all 0.3s;
}
.tab-active {
  color: #FF6B35;
  font-weight: 700;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8C5A, #FF5722);
  border-radius: 3rpx;
}

/* 表单内容 */
.form-body {}
.input-group {
  margin-bottom: 28rpx;
}
.input-label {
  font-size: 26rpx;
  color: #636E72;
  margin-bottom: 12rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.input-wrap {
  display: flex;
  align-items: center;
  background: #F6F7F9;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 96rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s;
}
.input-wrap:focus-within {
  background: #ffffff;
  border-color: #FF6B35;
  box-shadow: 0 0 0 6rpx rgba(255, 107, 53, 0.08);
}
.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D3436;
  height: 96rpx;
}

.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 32rpx rgba(255, 87, 34, 0.3);
}
.submit-btn::after { border: none; }
.submit-btn[disabled] {
  background: linear-gradient(135deg, #FFB399, #FF9066);
  box-shadow: none;
}
