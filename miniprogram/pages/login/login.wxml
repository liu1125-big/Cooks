<view class="login-page">
  <!-- 装饰背景 -->
  <view class="bg-decor">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
  </view>

  <!-- Logo区域 -->
  <view class="hero-area">
    <view class="logo-emoji">🍳</view>
    <view class="logo-text">Cooks</view>
    <view class="logo-sub">智能点餐 · 轻松管理</view>
  </view>

  <!-- 表单区域 -->
  <view class="form-card slide-up">
    <!-- Tab 切换 -->
    <view class="tab-bar">
      <view class="tab-item {{isLogin ? 'tab-active' : ''}}" bindtap="switchToLogin">登录</view>
      <view class="tab-item {{!isLogin ? 'tab-active' : ''}}" bindtap="switchToRegister">注册</view>
    </view>

    <view class="form-body">
      <view class="input-group">
        <view class="input-label">用户名</view>
        <view class="input-wrap">
          <text class="input-icon">👤</text>
          <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onInputUsername" />
        </view>
      </view>

      <view class="input-group">
        <view class="input-label">密码</view>
        <view class="input-wrap">
          <text class="input-icon">🔒</text>
          <input class="form-input" type="password" placeholder="请输入密码" value="{{password}}" bindinput="onInputPassword" />
        </view>
      </view>

      <view class="input-group" wx:if="{{!isLogin}}">
        <view class="input-label">昵称</view>
        <view class="input-wrap">
          <text class="input-icon">😊</text>
          <input class="form-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onInputNickname" />
        </view>
      </view>

      <button class="submit-btn" bindtap="handleSubmit" disabled="{{loading}}">
        {{loading ? '请稍候...' : (isLogin ? '登 录' : '注 册')}}
      </button>
    </view>
  </view>
</view>
