.admin-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding-bottom: 40rpx;
}

/* 统计区域 */
.stats-area {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}
.stat-card {
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}
.stat-daily {
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
}
.stat-monthly {
  background: linear-gradient(135deg, #2D3436, #1A1A2E);
}
.stat-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.stat-icon {
  font-size: 28rpx;
}
.stat-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}
.stat-body {
  display: flex;
  align-items: center;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 6rpx;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}
.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 操作栏 */
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 28rpx 20rpx;
}
.section-bar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}
.add-btn {
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #fff;
  padding: 14rpx 28rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(255, 87, 34, 0.2);
}
.add-btn:active {
  transform: scale(0.95);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
  gap: 16rpx;
}

/* 列表 */
.buy-list {
  padding: 0 24rpx;
}
.buy-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s;
}
.buy-item:active { background: #FAFBFC; }
.buy-main { flex: 1; }
.buy-top-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.buy-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}
.buy-date {
  font-size: 22rpx;
  color: #95A5A6;
  font-weight: 500;
}
.buy-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}
.buy-calc {
  font-size: 24rpx;
  color: #95A5A6;
}
.buy-total {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 700;
}
.buy-user {
  font-size: 22rpx;
  color: #B2BEC3;
}

.buy-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.act-edit {
  color: #FF6B35;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(255, 107, 53, 0.06);
  border-radius: 100rpx;
}
.act-edit:active { background: rgba(255, 107, 53, 0.12); }
.act-delete {
  color: #E74C3C;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(231, 76, 60, 0.06);
  border-radius: 100rpx;
}
.act-delete:active { background: rgba(231, 76, 60, 0.12); }

/* 弹窗字段 */
.field-group {
  margin-bottom: 24rpx;
}
.field-row {
  display: flex;
  gap: 20rpx;
}
.field-half { flex: 1; }
.field-label {
  font-size: 26rpx;
  color: #636E72;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}
.field-input {
  background: #F4F5F7;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #2D3436;
  border: 2rpx solid transparent;
  transition: all 0.25s;
}
.field-input:focus {
  border-color: #FF6B35;
  background: #ffffff;
}
.picker-display {
  background: #F4F5F7;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #2D3436;
}
