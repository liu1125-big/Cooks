<view class="page-container">
  <!-- 顶部搜索栏 -->
  <view class="search-header">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索菜品名称" placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <view wx:if="{{searchKeyword}}" class="clear-btn" bindtap="clearSearch">✕</view>
    </view>
    <view class="recommend-btn" bindtap="onRecommend">
      <text class="recommend-icon">✨</text>
      <text class="recommend-text">推荐</text>
    </view>
  </view>

  <!-- 主体：左侧分类 + 右侧菜品 -->
  <view class="main-body">
    <!-- 左侧分类 -->
    <scroll-view class="sidebar" scroll-y>
      <view class="sidebar-inner">
        <view
          wx:for="{{categories}}"
          wx:key="index"
          class="sidebar-item {{currentCategory === item ? 'sidebar-active' : ''}}"
          data-category="{{item}}"
          bindtap="onSelectCategory"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="dish-area" scroll-y>
      <view wx:if="{{loading}}" class="loading-state">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <block wx:elif="{{categories.length > 0}}">
        <block wx:for="{{currentCategory ? [currentCategory] : categories}}" wx:for-item="cat">
          <view class="dish-section fade-in">
            <view class="section-label">
              <view class="section-dot"></view>
              <text>{{cat}}</text>
              <text class="section-count">{{groupedDishes[cat].length}}道</text>
            </view>
            <dish-card
              wx:for="{{groupedDishes[cat]}}"
              wx:for-item="dish"
              wx:key="id"
              dish="{{dish}}"
              bind:tap="onDishTap"
              bind:addcart="onAddToCart"
            />
          </view>
        </block>
      </block>

      <empty-state wx:else text="暂无菜品" icon="🍽️" subText="管理员还未添加菜品" />
    </scroll-view>
  </view>

  <!-- 浮动购物车栏 -->
  <cart-bar count="{{cartCount}}" />

  <!-- 今日推荐弹窗 -->
  <view class="rec-mask" wx:if="{{showRecommendPopup}}" bindtap="closeRecommendPopup" catch:touchmove="noop">
    <view class="rec-card" catch:tap="noop">
      <!-- 装饰背景 -->
      <view class="rec-decorate"></view>
      
      <!-- 关闭按钮 -->
      <view class="rec-close" bindtap="closeRecommendPopup">✕</view>
      
      <!-- 推荐标签 -->
      <view class="rec-badge">
        <text>✨</text>
        <text>今日推荐</text>
      </view>
      
      <!-- 菜品名称 -->
      <view class="rec-name">{{recommendDish.name}}</view>
      
      <!-- 分类标签 -->
      <view class="rec-category">{{recommendDish.category || '未分类'}}</view>
      
      <!-- 备注 -->
      <view wx:if="{{recommendDish.remark}}" class="rec-remark">{{recommendDish.remark}}</view>
      
      <!-- 操作按钮 -->
      <view class="rec-actions">
        <button class="rec-btn-detail" bindtap="goRecommendDetail">查看详情</button>
      </view>
    </view>
  </view>
</view>
