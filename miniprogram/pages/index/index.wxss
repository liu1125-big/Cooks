.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F7F9;
}

/* === 搜索栏 === */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #ffffff;
  gap: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F4F5F7;
  border-radius: 100rpx;
  padding: 0 28rpx;
  height: 76rpx;
  transition: all 0.25s;
  border: 2rpx solid transparent;
}
.search-box:focus-within {
  background: #ffffff;
  border-color: #FF6B35;
  box-shadow: 0 0 0 6rpx rgba(255, 107, 53, 0.08);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D3436;
  height: 76rpx;
}
.search-placeholder {
  color: #B2BEC3;
  font-size: 28rpx;
}
.clear-btn {
  font-size: 24rpx;
  color: #B2BEC3;
  padding: 12rpx;
  flex-shrink: 0;
}

.recommend-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0CC);
  color: #FF6B35;
  padding: 16rpx 28rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
  border: none;
  transition: all 0.2s;
}
.recommend-btn:active {
  transform: scale(0.95);
}
.recommend-icon {
  font-size: 28rpx;
}
.recommend-text {
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* === 主体内容区 === */
.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* === 左侧分类栏 === */
.sidebar {
  width: 176rpx;
  background: #ffffff;
  height: 100%;
  flex-shrink: 0;
}
.sidebar-inner {
  padding: 8rpx 0;
}
.sidebar-item {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #95A5A6;
  font-weight: 500;
  position: relative;
  transition: all 0.25s;
  border-left: 6rpx solid transparent;
}
.sidebar-active {
  background: linear-gradient(90deg, rgba(255, 107, 53, 0.06), transparent);
  color: #FF6B35;
  font-weight: 700;
  border-left-color: #FF6B35;
}
.sidebar-active::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 44rpx;
  background: #FF6B35;
  border-radius: 3rpx;
}

/* === 右侧菜品列表 === */
.dish-area {
  flex: 1;
  padding: 20rpx 20rpx 20rpx 16rpx;
  height: 100%;
}
.dish-section {
  margin-bottom: 12rpx;
}
.section-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 16rpx;
  padding: 4rpx 0;
}
.section-dot {
  width: 8rpx;
  height: 8rpx;
  background: #FF6B35;
  border-radius: 50%;
}
.section-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #B2BEC3;
  margin-left: auto;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
  gap: 16rpx;
}
.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #ECF0F1;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* === 今日推荐弹窗 === */
.rec-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(6rpx);
}

.rec-card {
  position: relative;
  width: 580rpx;
  background: linear-gradient(160deg, #FFF8F3 0%, #FFFFFF 100%);
  border-radius: 36rpx;
  padding: 56rpx 48rpx 48rpx;
  box-shadow: 0 32rpx 80rpx rgba(255, 107, 53, 0.18);
  overflow: hidden;
  animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  text-align: center;
}

@keyframes popIn {
  from { opacity: 0; transform: scale(0.8) translateY(30rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.rec-decorate {
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 280rpx; height: 280rpx;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.rec-close {
  position: absolute;
  top: 24rpx; right: 24rpx;
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #B2BEC3;
  border-radius: 50%;
  background: #F6F7F9;
}

.rec-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0CC);
  color: #FF6B35;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.rec-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #2D3436;
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.rec-category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin: 0 auto 20rpx;
  line-height: 1;
}

.rec-remark {
  text-align: center;
  font-size: 28rpx;
  color: #95A5A6;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.rec-actions {
  margin-top: 8rpx;
}

.rec-btn-detail {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 87, 34, 0.25);
}
.rec-btn-detail::after { border: none; }
.rec-btn-detail:active {
  transform: scale(0.97);
  opacity: 0.92;
}
