.admin-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding-bottom: 40rpx;
}

/* 顶部栏 */
.page-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3436;
}
.user-count {
  font-size: 26rpx;
  color: #95A5A6;
  font-weight: 500;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
  gap: 16rpx;
}

/* 用户列表 */
.user-list {
  padding: 24rpx;
}
.user-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s;
}
.user-item:active {
  background: #FAFBFC;
}

.user-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}
.user-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #F0F0F0, #E8E8E8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.user-avatar-emoji {
  font-size: 40rpx;
}
.user-info { flex: 1; }
.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.user-nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}
.user-meta {
  font-size: 24rpx;
  color: #95A5A6;
}

.user-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.act-edit {
  color: #FF6B35;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(255, 107, 53, 0.06);
  border-radius: 100rpx;
}
.act-edit:active { background: rgba(255, 107, 53, 0.12); }
.act-delete {
  color: #E74C3C;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(231, 76, 60, 0.06);
  border-radius: 100rpx;
}
.act-delete:active { background: rgba(231, 76, 60, 0.12); }

/* 角色选择 */
.role-list {
  margin-bottom: 8rpx;
}
.role-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  text-align: center;
  border: 2rpx solid #ECF0F1;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  color: #636E72;
  font-weight: 500;
  transition: all 0.25s;
}
.role-option:active {
  background: #FAFBFC;
}
.role-selected {
  border-color: #FF6B35;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.04);
  font-weight: 700;
}
.role-emoji {
  font-size: 36rpx;
}
