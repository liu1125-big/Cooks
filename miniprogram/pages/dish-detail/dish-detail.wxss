.detail-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding-bottom: 60rpx;
}

/* 大图区域 */
.hero-image {
  width: 100%;
  height: 520rpx;
  background: linear-gradient(135deg, #FFF5EE, #FFE0CC);
  position: relative;
  overflow: hidden;
}
.dish-img {
  width: 100%;
  height: 100%;
}
.img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-icon {
  font-size: 160rpx;
  opacity: 0.6;
}
.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(to top, #F6F7F9, transparent);
}

/* 内容区域 */
.content-area {
  padding: 0 24rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 1;
}

.info-card, .action-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.05);
}

.dish-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #2D3436;
  line-height: 1.3;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.dish-tags {
  margin-bottom: 24rpx;
}
.cat-tag {
  display: inline-block;
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 87, 34, 0.2);
}

.remark-section {
  padding-top: 8rpx;
}
.remark-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #636E72;
}
.remark-dot {
  width: 8rpx;
  height: 8rpx;
  background: #FF6B35;
  border-radius: 50%;
}
.remark-text {
  font-size: 28rpx;
  color: #636E72;
  line-height: 1.8;
  padding-left: 18rpx;
}

/* 操作卡片 */
.fav-btn-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.fav-emoji {
  font-size: 40rpx;
}
.fav-label {
  font-size: 30rpx;
  color: #2D3436;
  font-weight: 500;
}
.fav-btn-row:active {
  opacity: 0.7;
}

.divider {
  height: 1rpx;
  background: #ECF0F1;
  margin: 12rpx 0 24rpx;
}

.cart-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 32rpx rgba(255, 87, 34, 0.25);
}
.cart-btn::after { border: none; }
.cart-btn:active {
  transform: scale(0.97);
}
.btn-icon {
  font-size: 36rpx;
}

/* 加载/错误状态 */
.loading-page, .error-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 20rpx;
}
.loading-label, .error-text {
  font-size: 28rpx;
  color: #B2BEC3;
}
.error-icon {
  font-size: 80rpx;
}
