/* ============================================================
   全局样式 - Cooks 点餐小程序
   设计风格：现代简约、温暖橙色调
   ============================================================ */

page {
  background-color: #F6F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #2D3436;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ---- 色彩系统 ---- */
.primary { color: #FF6B35; }
.bg-primary { background-color: #FF6B35; }
.text-danger { color: #E74C3C; }
.text-success { color: #27AE60; }
.text-gray { color: #95A5A6; }
.text-muted { color: #7F8C8D; }
.text-dark { color: #2D3436; }
.text-secondary { color: #636E72; }

/* ---- 布局工具 ---- */
.flex { display: flex; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }
.align-center { align-items: center; }
.align-start { align-items: flex-start; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }

/* ---- 间距 ---- */
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }
.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.px-20 { padding-left: 20rpx; padding-right: 20rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }

/* ---- 按钮系统 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  padding: 0 52rpx;
  line-height: 92rpx;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 87, 34, 0.25);
}
.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
  box-shadow: 0 4rpx 12rpx rgba(255, 87, 34, 0.2);
}

.btn-outline {
  background: transparent;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
}
.btn-outline::after { border: none; }
.btn-outline:active { background: rgba(255, 107, 53, 0.06); }

.btn-ghost {
  background: transparent;
  color: #FF6B35;
  border: none;
  height: auto;
  padding: 0;
  font-size: 28rpx;
}

.btn-danger {
  background: linear-gradient(135deg, #FF6B6B, #E74C3C);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(231, 76, 60, 0.2);
}
.btn-danger::after { border: none; }

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
}

/* ---- 卡片 ---- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-hover {
  transition: all 0.25s ease;
}
.card-hover:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* ---- 输入框 ---- */
.input {
  background-color: #F4F5F7;
  border-radius: 18rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.25s;
  color: #2D3436;
}
.input:focus {
  border-color: #FF6B35;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 53, 0.08);
}
.input::placeholder { color: #B2BEC3; }

/* ---- 标签 / Badge ---- */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.5rpx;
}
.tag-orange {
  background-color: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
}
.tag-green {
  background-color: rgba(39, 174, 96, 0.1);
  color: #27AE60;
}
.tag-red {
  background-color: rgba(231, 76, 60, 0.1);
  color: #E74C3C;
}
.tag-gray {
  background-color: rgba(149, 165, 166, 0.12);
  color: #7F8C8D;
}
.tag-dark {
  background-color: rgba(45, 52, 54, 0.08);
  color: #636E72;
}

/* ---- 分割线 ---- */
.divider {
  height: 1rpx;
  background-color: #ECF0F1;
  margin: 28rpx 0;
}

/* ---- 空状态 ---- */
.empty-text {
  text-align: center;
  color: #B2BEC3;
  padding: 100rpx 0;
  font-size: 28rpx;
}

/* ---- 页面容器 ---- */
.page {
  min-height: 100vh;
  background: #F6F7F9;
}

/* ---- 加载状态 ---- */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #ECF0F1;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---- 安全区适配 ---- */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.safe-top { padding-top: env(safe-area-inset-top); }

/* ---- 文字截断 ---- */
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ---- 动画 ---- */
.fade-in { animation: fadeIn 0.35s ease; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.slide-up { animation: slideUp 0.35s ease; }
@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- 列表项通用 ---- */
.list-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s;
}
.list-item:active {
  background: #FAFBFC;
  transform: scale(0.99);
}

/* ---- 弹窗遮罩 ---- */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(4rpx);
}
.popup-content {
  width: 88%;
  max-height: 84vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 52rpx 44rpx 44rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.18);
  animation: popIn 0.3s ease;
  box-sizing: border-box;
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}
.popup-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.popup-actions button { flex: 1; }

/* ---- 区块标题 ---- */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  letter-spacing: 0.5rpx;
}
.section-subtitle {
  font-size: 24rpx;
  color: #95A5A6;
}
