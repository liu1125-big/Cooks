.dish-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.dish-thumb {
  width: 210rpx;
  height: 210rpx;
  flex-shrink: 0;
  position: relative;
  background: linear-gradient(135deg, #FFF5EE, #FFE8D6);
  border-radius: 24rpx 0 0 24rpx;
  overflow: hidden;
}
.dish-image {
  width: 100%;
  height: 100%;
}
.dish-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-emoji {
  font-size: 72rpx;
  opacity: 0.7;
}

.dish-body {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 210rpx;
  box-sizing: border-box;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.dish-meta {
  margin-bottom: 8rpx;
}
.dish-category-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.08);
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
}

.dish-remark {
  font-size: 24rpx;
  color: #95A5A6;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.dish-footer {
  margin-top: auto;
  padding-top: 8rpx;
  display: flex;
  justify-content: flex-end;
}
.add-cart-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FF8C5A, #FF5722);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 87, 34, 0.2);
}
.add-cart-btn:active {
  transform: scale(0.95);
}
.cart-icon-sm {
  font-size: 24rpx;
}
