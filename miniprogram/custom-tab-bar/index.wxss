.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tab-bar-inner {
  display: flex;
  height: 110rpx;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 100%;
  padding-top: 8rpx;
}

.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.25s ease;
  margin-bottom: 6rpx;
}
.tab-icon-active-wrap {
  background: rgba(255, 107, 53, 0.08);
  transform: scale(1.1);
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  transition: all 0.2s;
}

.tab-text {
  font-size: 22rpx;
  color: #95A5A6;
  font-weight: 500;
  transition: all 0.2s;
  line-height: 1;
}

.tab-active .tab-text {
  color: #FF6B35;
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  bottom: 10rpx;
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8C5A, #FF5722);
  border-radius: 3rpx;
}
